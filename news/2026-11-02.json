emma": "suo", "meaning": "seu (dele)", "pos": "possessivo", "synonyms": []}, "teatro": {"example": "Stasera andiamo a teatro.", "examplePt": "Hoje à noite vamos ao teatro.", "lemma": "teatro", "meaning": "teatro", "pos": "substantivo masculino", "synonyms": []}, "televisione": {"example": "Guardo poco la televisione.", "examplePt": "Vejo pouca televisão.", "lemma": "televisione", "meaning": "televisão", "pos": "substantivo feminino", "synonyms": ["TV"]}, "tolto": {"example": "Si è tolto le scarpe.", "examplePt": "Ele tirou os sapatos.", "lemma": "togliere", "meaning": "tirou", "note": "Particípio irregular de togliere: si è tolto = tirou (de si).", "pos": "verbo", "synonyms": ["levato"]}, "tutti": {"example": "Tutti amano la pizza.", "examplePt": "Todos amam pizza.", "lemma": "tutto", "meaning": "todos", "note": "Plural masculino de tutto.", "pos": "pronome", "synonyms": ["ognuno"]}, "tutto": {"example": "Ho mangiato tutto.", "examplePt": "Comi tudo.", "lemma": "tutto", "meaning": "tudo, totalmente", "note": "'Tutto esaurito' = totalmente esgotado.", "pos": "adjetivo", "synonyms": ["completamente"]}, "ultimo": {"example": "Il suo ultimo film è bello.", "examplePt": "O último filme dele é bom.", "lemma": "ultimo", "meaning": "último, mais recente", "pos": "adjetivo", "synonyms": ["recente"]}, "un": {"example": "Ho un cane.", "examplePt": "Tenho um cachorro.", "lemma": "un", "meaning": "um", "pos": "artigo indefinido", "synonyms": []}, "una": {"example": "Ho una sorella.", "examplePt": "Tenho uma irmã.", "lemma": "una", "meaning": "uma", "pos": "artigo indefinido", "synonyms": []}, "vestiti": {"example": "Metto i vestiti nell'armadio.", "examplePt": "Ponho as roupas no armário.", "lemma": "vestito", "meaning": "roupas", "note": "Plural de vestito.", "pos": "substantivo masculino", "synonyms": ["abiti"]}, "voi": {"example": "Voi siete italiani?", "examplePt": "Vocês são italianos?", "lemma": "voi", "meaning": "vocês", "pos": "pronome", "synonyms": []}, "wars": {"example": "Star Wars è un film famoso.", "examplePt": "Star Wars é um filme famoso.", "lemma": "Wars", "meaning": "Wars (parte de Star Wars)", "note": "Palavra inglesa: guerras.", "pos": "nome próprio", "synonyms": []}, "yoda": {"example": "Yoda è un maestro Jedi.", "examplePt": "Yoda é um mestre Jedi.", "lemma": "Yoda", "meaning": "Yoda (personagem de Star Wars)", "pos": "nome próprio", "synonyms": []}, "è": {"example": "Roma è bella.", "examplePt": "Roma é bonita.", "lemma": "essere", "meaning": "é; auxiliar do passato prossimo", "note": "Presente de essere, lui/lei: è. 'È salito' = subiu.", "pos": "verbo", "synonyms": []}}, "level": "A2", "paragraphs": ["Sabato 31 ottobre a Lucca c'è stata una grande sorpresa. Durante il festival Lucca Comics & Games, un Mandaloriano ha guidato la parata di Star Wars. Sotto il casco c'era Alberto Angela, il famoso divulgatore della televisione italiana.", "Angela ha camminato per le strade della città con Baby Yoda in braccio. Intorno a lui c'erano Jedi, Stormtrooper e Sith. Lungo il percorso nessuno lo ha riconosciuto.", "Davanti al Teatro del Giglio, Angela si è tolto il casco e ha salutato il pubblico. Ha detto: «Era molto buffo andare in giro e nessuno mi riconosceva, era una cosa bellissima». E poi: «Sono un appassionato come tutti voi».", "Dopo la parata, Angela ha cambiato i vestiti ed è salito sul palco del teatro. Ha presentato il suo ultimo libro, «Cesare. La conquista dell'eternità», pubblicato da Mondadori. La sala era piena: tutto esaurito.", "Quest'anno Lucca Comics & Games festeggia sessant'anni. Sabato è stata la giornata più affollata della fiera. Il festival è finito domenica 1 novembre.", "Alla fine Angela ha dato un consiglio al pubblico: «Se avete un sogno nel cassetto, realizzatelo»."], "paragraphsPt": ["No sábado, 31 de outubro, houve uma grande surpresa em Lucca. Durante o festival Lucca Comics & Games, um Mandaloriano liderou o desfile de Star Wars. Debaixo do capacete estava Alberto Angela, o famoso divulgador da televisão italiana.", "Angela caminhou pelas ruas da cidade com o Baby Yoda no colo. Ao redor dele havia Jedi, Stormtroopers e Sith. Ao longo do percurso, ninguém o reconheceu.", "Em frente ao Teatro del Giglio, Angela tirou o capacete e cumprimentou o público. Ele disse: «Era muito engraçado andar por aí e ninguém me reconhecia, era uma coisa linda». E depois: «Sou um fã como todos vocês».", "Depois do desfile, Angela trocou de roupa e subiu ao palco do teatro. Apresentou seu livro mais recente, «Cesare. La conquista dell'eternità» (César. A conquista da eternidade), publicado pela Mondadori. A sala estava cheia: lotação esgotada.", "Este ano o Lucca Comics & Games comemora sessenta anos. O sábado foi o dia mais lotado da feira. O festival terminou no domingo, 1º de novembro.", "No final, Angela deu um conselho ao público: «Se vocês têm um sonho guardado na gaveta, realizem-no»."], "quiz": [{"answer": 1, "explanation": "O texto diz: «Sotto il casco c'era Alberto Angela».", "options": ["Un attore di Star Wars", "Alberto Angela", "Il sindaco di Lucca", "Un bambino"], "q": "Chi c'era sotto il casco del Mandaloriano?"}, {"answer": 0, "explanation": "Ele caminhou «con Baby Yoda in braccio» — com o Baby Yoda no colo.", "options": ["Baby Yoda", "Un libro", "Un casco", "Una spada"], "q": "Che cosa aveva in braccio Angela durante la parata?"}, {"answer": 2, "explanation": "«Davanti al Teatro del Giglio, Angela si è tolto il casco».", "options": ["In una strada del centro", "Sul palco", "Davanti al Teatro del Giglio", "Alla fiera del libro"], "q": "Dove si è tolto il casco Angela?"}, {"answer": 3, "explanation": "O livro se chama «Cesare. La conquista dell'eternità» — sobre Júlio César.", "options": ["Di Star Wars", "Della città di Lucca", "Della televisione", "Di Cesare"], "q": "Di che cosa parla il libro presentato da Angela?"}, {"answer": 0, "explanation": "Salire (subir), como andare e arrivare, indica movimento e forma o passato prossimo com essere: è salito.", "options": ["Perché salire è un verbo di movimento e usa essere", "Perché il soggetto è femminile", "Perché è al futuro", "Perché salire usa sempre avere"], "q": "Perché si dice «è salito» e non «ha salito»?"}, {"answer": 1, "explanation": "«Sogno nel cassetto» é um sonho guardado, um desejo que ainda não foi realizado.", "options": ["Un brutto sogno", "Un desiderio ancora da realizzare", "Un oggetto perso", "Un regalo"], "q": "Che cosa significa «un sogno nel cassetto»?"}], "sources": [{"name": "Altopascio.info", "url": "https://altopascio.info/2026/11/01/lucca-comics-alberto-angela-mandaloriano-parata-star-wars-baby-yoda-teatro-del-giglio"}, {"name": "LuccaInDiretta", "url": "https://luccaindiretta.it/cultura-e-spettacoli/2026/10/31/alberto-angela-in-versione-mandaloriano-ingresso-stellare-a-lucca-comics/527222"}], "title": "Alberto Angela diventa un Mandaloriano a Lucca", "titlePt": "Alberto Angela vira um Mandaloriano em Lucca", "topic": "Cultura"}